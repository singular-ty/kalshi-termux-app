# Kalshi API (never commit real values)
KALSHI_KEY_ID=
# Path to RSA private key PEM (chmod 600). Default: ./secrets/kalshi.key
KALSHI_KEY_PATH=secrets/kalshi.key

# API host switch:
#   external  -> https://external-api.kalshi.com   (recommended)
#   elections -> https://api.elections.kalshi.com (legacy shared host)
#   demo      -> https://demo-api.kalshi.co
KALSHI_HOST=external

# Trading safety (default dry-run)
DRY_RUN=1
# Fractional Kelly (0.25–0.5 typical). Hard max fraction of bankroll per trade.
KELLY_FRACTION=0.5
KELLY_MAX_FRACTION=0.05

# Scanner
SCAN_LIMIT=100
CACHE_TTL_SECONDS=10
MAX_CONTRACT_PRICE_CENTS=40
MIN_PAYOUT_MULTIPLE=2.0

# Server
HOST=0.0.0.0
PORT=8787

# Optional: passphrase unlocks encrypted vault (or enter via Settings UI)
# VAULT_PASSPHRASE=
